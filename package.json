{
  "name": "readme-scan",
  "version": "0.1.0",
  "description": "Generate a README.md by scanning your project. Runs locally, no API key needed.",
  "type": "module",
  "bin": {
    "readme-scan": "./bin/readme-scan.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node ./bin/readme-scan.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint:readme": "node ./bin/readme-scan.js lint README.md",
    "check:readme": "node ./bin/readme-scan.js --check",
    "examples": "node ./bin/readme-scan.js --force -o examples/express-api/README.md examples/express-api",
    "check:prepublish": "node ./scripts/prepublish-check.js",
    "prepublishOnly": "npm run check:prepublish"
  },
  "keywords": [
    "readme",
    "readme-generator",
    "generate-readme",
    "documentation",
    "markdown",
    "cli",
    "developer-tools",
    "static-analysis",
    "offline"
  ],
  "author": "David Yehuda Surbakti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidyehuda45-byte/readme-scan.git"
  },
  "homepage": "https://github.com/davidyehuda45-byte/readme-scan#readme",
  "bugs": {
    "url": "https://github.com/davidyehuda45-byte/readme-scan/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
